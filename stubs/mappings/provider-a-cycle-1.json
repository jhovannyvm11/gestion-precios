{
  "request": {
    "method": "GET",
    "urlPathPattern": "/a/prices/.*"
  },
  "response": {
    "status": 200,
    "fixedDelayMilliseconds": 100,
    "headers": {"Content-Type": "application/json"},
    "jsonBody": {
      "sku": "{{request.pathSegments.[2]}}",
      "basePrice": 100.0,
      "currency": "USD",
      "lastUpdated": "{{now}}"
    }
  },
  "priority": 10,
  "scenarioName": "provider-a-freshness-cycle",
  "requiredScenarioState": "1",
  "newScenarioState": "2"
}